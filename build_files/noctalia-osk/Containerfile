# Builds Fedora's noctalia with the lock-screen on-screen keyboard patch
# (upstream PR #5233). Output: RPMs in /out, or nothing once Fedora's
# noctalia already includes the feature. CI caches the result keyed on
# Fedora's noctalia version and this directory's and patches/ contents,
# so the ~70 min compile only runs when one of those changes.
#   podman build -f build_files/noctalia-osk/Containerfile -t noctalia-osk .
FROM registry.fedoraproject.org/fedora:45
COPY patches /patches
COPY build_files/noctalia-osk/build-noctalia.sh /build-noctalia.sh
RUN --mount=type=cache,dst=/var/cache/libdnf5 /build-noctalia.sh
