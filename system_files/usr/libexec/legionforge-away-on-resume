#!/bin/bash
# LegionForge: if the Go wakes from sleep while the niri desktop is open,
# go straight to Gaming Mode so Steam's PIN applies, instead of waking into an
# unlocked desktop. (Noctalia's lock-before-suspend is off: it needs a keyboard.)
set -uo pipefail
gdbus monitor --system --dest org.freedesktop.login1 \
    --object-path /org/freedesktop/login1 |
while read -r line; do
  if [[ "$line" == *"PrepareForSleep (false)"* ]]; then
    exec /usr/libexec/legionforge-away
  fi
done
