#!/bin/bash
# Legix: swap Bazzite's Steam Gaming Mode startup/suspend videos for Legix's.
# Bazzite's steam-tweaks copies /usr/share/ublue-os/bazzite/*.webm into the
# user's Steam overrides only when a file is missing, so users who already have
# Bazzite's copies keep them. Replace only files that are byte-identical to a
# Bazzite original (checksums recorded at image build time); custom videos,
# Animation Changer setups and the "no videos" choice are left alone.
set -euo pipefail
dir="$HOME/.local/share/Steam/config/uioverrides/movies"
sums=/usr/share/legix/bazzite-video-md5sums
[[ -d "$dir" && -r "$sums" ]] || exit 0
[[ -e "$dir/bazzite_novideo" || -f "$HOME/homebrew/plugins/SDH-AnimationChanger/main.py" ]] && exit 0
startup=/usr/share/ublue-os/bazzite/bazzite.webm
suspend=/usr/share/ublue-os/bazzite/bazzite-suspend.webm
shopt -s nullglob
for f in "$dir"/*.webm; do
  sum="$(md5sum < "$f" | cut -d' ' -f1)"
  grep -qx "$sum" "$sums" || continue
  case "$(basename "$f")" in
    *suspend*) install -m0644 "$suspend" "$f" ;;
    *startup*) install -m0644 "$startup" "$f" ;;
  esac
done
