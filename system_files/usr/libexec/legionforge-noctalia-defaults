#!/bin/bash
# LegionForge: install the image's Noctalia defaults into the user's config dir.
# Noctalia merges every *.toml in ~/.config/noctalia (it does not read
# XDG_CONFIG_DIRS), and both the user's own files and the Settings UI state
# (~/.local/state/noctalia/settings.toml) override these defaults.
set -euo pipefail
src=/usr/share/legionforge/noctalia/00-legionforge-defaults.toml
dir="${XDG_CONFIG_HOME:-$HOME/.config}/noctalia"
[[ -e "$dir/.legionforge-no-defaults" ]] && exit 0
mkdir -p "$dir"
if ! cmp -s "$src" "$dir/00-legionforge-defaults.toml"; then
  install -m 0644 "$src" "$dir/00-legionforge-defaults.toml"
fi
