[Unit]
Description=LegionForge: lock the desktop as soon as niri starts
Documentation=https://github.com/shad0wcrawl3r/LegionForge
After=noctalia.service
Requires=noctalia.service
PartOf=niri.service
# Opt out machine-wide or per user (ujust toggle-desktop-lock).
ConditionPathExists=!/etc/legionforge/no-lock-on-desktop
ConditionPathExists=!%h/.config/legionforge/no-lock-on-desktop

[Service]
Type=oneshot
ExecStart=/usr/libexec/legionforge-lock-on-desktop
